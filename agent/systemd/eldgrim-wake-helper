#!/bin/bash
# Eldgrim wake helper. Installed root-owned into /usr/local/libexec/eldgrim/ by
# install-wake.sh. Root never runs Eldgrim's Python code: it only reads the chosen
# moment as data, writes the wake timer, and decides about returning to sleep.
#
#   stamp FILE   print the validated OnCalendar stamp from a next-run.json (no root needed)
#   arm          write and restart the wake timer from the saved choice
#   begin        before a run: note whether the timer just woke the computer, then settle
#   finish       after a run: re-arm, and suspend again only if the timer woke the
#                computer and no other program holds sleep off
#   blockers     list programs that hold suspend off in block mode (not Eldgrim)
#   rehearse N   wake test: arm the timer N minutes ahead (1-30), mark the run as a
#                wake test, and suspend now; the woken run posts and sleeps again
set -uo pipefail

NEXT_FILE="${ELDGRIM_NEXT_FILE:-@HOME@/.local/share/eldgrim/next-run.json}"
TIMER_FILE=/etc/systemd/system/eldgrim-daily.timer
STATE_DIR=/run/eldgrim
WOKEN="$STATE_DIR/woken"
REHEARSAL="$STATE_DIR/rehearsal"
SETTLE_SECONDS="${ELDGRIM_SETTLE_SECONDS:-30}"
RESUME_WINDOW=300
MAX_AHEAD=$((50 * 3600))

log() { echo "eldgrim-wake: $*"; }

stamp() {
  local file="$1" at epoch now
  [ -f "$file" ] || { log "no saved choice at $file"; return 1; }
  # Read at most 4 KiB and extract only a strict timestamp; nothing else is used.
  at=$(head -c 4096 -- "$file" | grep -oE '"at"[[:space:]]*:[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2})?"' \
        | head -n 1 | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2})?')
  [ -n "$at" ] || { log "saved choice has no valid timestamp"; return 1; }
  epoch=$(date -d "$at" +%s 2>/dev/null) || { log "saved choice is not a real time"; return 1; }
  now=$(date +%s)
  if [ "$epoch" -le "$now" ] || [ "$epoch" -gt $((now + MAX_AHEAD)) ]; then
    log "saved choice $at is not in the coming two days"
    return 1
  fi
  date -d "@$epoch" '+%Y-%m-%d %H:%M:00'
}

arm() {
  local when
  when=$(stamp "$NEXT_FILE") || return 1
  write_timer "$when"
}

write_timer() {
  local when="$1" tmp
  tmp=$(mktemp "${TIMER_FILE}.XXXXXX") || return 1
  cat >"$tmp" <<EOF
[Unit]
Description=Wake the computer for Eldgrim's next chosen moment

[Timer]
OnCalendar=$when
Persistent=false
WakeSystem=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=eldgrim-daily.service

[Install]
WantedBy=timers.target
EOF
  chmod 0644 "$tmp" && mv -f "$tmp" "$TIMER_FILE" || { rm -f "$tmp"; return 1; }
  systemctl daemon-reload && systemctl enable --quiet eldgrim-daily.timer \
    && systemctl restart eldgrim-daily.timer || return 1
  log "wake timer armed for $when"
}

resumed_recently() {
  # Only a completed resume counts: systemd-sleep logs this line after waking,
  # never after a suspend that failed.
  local last now
  last=$(journalctl -b -t systemd-sleep -o short-unix -q --no-pager 2>/dev/null \
          | grep 'returned from sleep' | tail -n 1 | awk '{print int($1)}')
  [ -n "$last" ] || return 1
  now=$(date +%s)
  [ $((now - last)) -le "$RESUME_WINDOW" ]
}

begin() {
  mkdir -p "$STATE_DIR"
  if resumed_recently; then
    : >"$WOKEN"
    log "the computer just resumed; settling ${SETTLE_SECONDS}s before the run"
    sleep "$SETTLE_SECONDS"
  else
    rm -f "$WOKEN"
    log "the computer was already awake; it will be left awake"
  fi
  return 0
}

inhibitor_list() {
  if [ -n "${ELDGRIM_INHIBIT_LIST:-}" ]; then cat -- "$ELDGRIM_INHIBIT_LIST"
  else systemd-inhibit --list --no-legend --no-pager 2>/dev/null; fi
}

sleep_blockers() {
  # Only a block-mode inhibitor on "sleep" objects to a suspend request. Idle
  # blocks (a game profile, a video) only stop automatic idle-suspend, and the
  # computer was asleep with them a moment ago. Print the WHO of each blocker.
  inhibitor_list | grep -v 'Eldgrim' | awk '
    $NF == "block" {
      for (i = 1; i < NF; i++) if ($i ~ /(^|:)sleep(:|$)/) { print $1; next }
    }'
}

finish() {
  rm -f "$REHEARSAL"
  arm || log "could not re-arm the wake timer"
  if [ ! -f "$WOKEN" ]; then
    log "not woken by the timer; leaving power alone"
    return 0
  fi
  rm -f "$WOKEN"
  local blockers
  if ! blockers=$(sleep_blockers); then
    log "could not read sleep inhibitors; leaving the computer awake"
    return 0
  fi
  if [ -n "$blockers" ]; then
    log "sleep is held off by: $(echo $blockers); leaving the computer awake"
    return 0
  fi
  log "run finished after a timer wake; returning to sleep"
  systemctl suspend || log "suspend request failed"
  return 0
}

rehearse() {
  local minutes="${1:-1}" target when
  case "$minutes" in ''|*[!0-9]*) log "minutes must be a whole number"; return 2 ;; esac
  if [ "$minutes" -lt 1 ] || [ "$minutes" -gt 30 ]; then
    log "choose between 1 and 30 minutes"; return 2
  fi
  # To the second: suspend starts about 3 seconds from now, leaving the rest of
  # the interval for the computer to fall asleep before the RTC alarm.
  target=$(( $(date +%s) + minutes * 60 ))
  when=$(date -d "@$target" '+%Y-%m-%d %H:%M:%S')
  write_timer "$when" || { log "could not arm the wake test"; return 1; }
  mkdir -p "$STATE_DIR"
  echo "$when" >"$REHEARSAL"
  chmod 0644 "$REHEARSAL"
  log "wake test: the computer sleeps now and wakes at $when"
  log "afterwards: journalctl -u eldgrim-daily.service -b --since -1h"
  sync
  sleep 3
  if ! systemctl suspend; then
    log "suspend was refused; the run will still start at $when with the computer awake"
  fi
}

case "${1:-}" in
  stamp) stamp "${2:-$NEXT_FILE}" ;;
  arm) arm ;;
  begin) begin ;;
  finish) finish ;;
  blockers) sleep_blockers ;;
  rehearse) rehearse "${2:-1}" ;;
  *) echo "usage: $0 stamp [FILE] | arm | begin | finish | blockers | rehearse [MINUTES]" >&2; exit 2 ;;
esac
